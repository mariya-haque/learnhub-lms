# Copy this file to `.env` and edit. `.env` is gitignored; this template is not.

# --- Database ---------------------------------------------------------------
# Leave unset for zero-setup SQLite (creates ./lms.db on first run).
# For Postgres, uncomment and point at your server -- the app rewrites the URL
# to use the psycopg3 driver automatically.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_db

# --- App --------------------------------------------------------------------
APP_NAME=LearnHub
# APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Security ---------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
# JWT signing algorithm; there is rarely a reason to change it.
# ALGORITHM=HS256

# --- Uploads ----------------------------------------------------------------
# Absolute path preferred. Defaults to ./uploads next to this file.
# UPLOAD_DIR=
MAX_VIDEO_MB=512
MAX_NOTE_MB=32

# --- Assessments ------------------------------------------------------------
DEFAULT_PASS_PERCENT=40
GRAND_TEST_DEFAULT_MINUTES=60
LECTURE_COMPLETE_RATIO=0.9

# --- Live classes -----------------------------------------------------------
# Built-in class rooms are iframed from this Jitsi instance, so scheduling a
# class needs no account and no media server of your own. The public instance
# has no room passwords -- privacy rests entirely on the random room name.
# Point this at a self-hosted Jitsi for anything confidential.
MEET_DOMAIN=meet.jit.si
# How many minutes before the start time students may enter the room.
CLASS_JOIN_LEAD_MINUTES=10

# --- Login page --------------------------------------------------------------
# Print the demo accounts and passwords on the sign-in page, with one-click
# fill buttons. Leave false on anything reachable from the internet -- it is a
# login bypass, not a convenience. The accounts still work either way.
SHOW_DEMO_CREDENTIALS=false

# --- First run --------------------------------------------------------------
# Creates admin/teacher/student demo accounts and one sample course on startup.
# Set to false before going anywhere near production.
SEED_DEMO_DATA=true
